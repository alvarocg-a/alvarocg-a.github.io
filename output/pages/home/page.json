    {
      "section": 2,
      "rect": {
        "x": 41,
        "y": 1614,
        "w": 638,
        "h": 234
      },
      "type": "text",
      "tag": "p",
      "level": null,
      "text": "Winx Club: The Magic Is Back aims to deliver an experience that feels both familiar and entirely new.\nPlayers will explore some of the most beloved and iconic locations from the Winx universe.\nPlayers can freely switch between all six fairies, each with their own distinctive magical abilities, to overcome enemies and puzzles in creative new ways.",
      "links": [],
      "style": {
        "font": "prompt, sans-serif",

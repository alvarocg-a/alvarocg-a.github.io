        "h": 30
      },
      "type": "text",
      "tag": "p",
      "level": null,
      "text": "I have been involved in the design and creation of the beatchart for Bugs N' Guns.",
      "links": [],
      "style": {
        "font": "prompt, sans-serif",
        "size": "20px",
        "weight": "400",
        "color": "rgb(255, 255, 255)",
        "align": "start",
        "lineHeight": "normal",
        "letterSpacing": "normal",
        "transform": "none",

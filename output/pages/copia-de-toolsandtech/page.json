      }
    },
    {
      "section": 1,
      "rect": {
        "x": 753,
        "y": 2133,
        "w": 820,
        "h": 60
      },
      "type": "text",
      "tag": "p",
      "level": null,
      "text": "This has been a tool we've used to define the rhythm, intensity, and duration of all the level phases.",
      "links": [],
      "style": {

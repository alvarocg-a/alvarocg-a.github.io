        "letterSpacing": "normal",
        "transform": "none",
        "italic": false
      }
    },
    {
      "section": 0,
      "rect": {
        "x": 1529,
        "y": 1356,
        "w": 90,
        "h": 30
      },
      "type": "heading",
      "tag": "h2",

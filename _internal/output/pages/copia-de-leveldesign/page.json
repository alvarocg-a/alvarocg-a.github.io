    {
      "section": 0,
      "rect": {
        "x": 232,
        "y": 501,
        "w": 978,
        "h": 270
      },
      "type": "text",
      "tag": "p",
      "level": null,
      "text": "This is a small minigame I created within the game as an Easter egg during my brief downtime. It consists of pitting the two players from Bugs N' Guns against each other in a 1v1 soccer match.\nThe main feature of the minigame is the somewhat exaggerated physics of the ball. It not only reacts to the players and the environment but also gains much more force when hit with the blinkshot.",
      "links": [],
      "style": {
        "font": "prompt, sans-serif",
        "size": "22px",
        "weight": "400",
        "color": "rgb(255, 255, 255)",
        "align": "start",
        "lineHeight": "38.5px",
        "letterSpacing": "normal",
        "transform": "none",
        "italic": false
      }
    },
    {
      "section": 0,
      "rect": {
        "x": 232,
        "y": 771,
        "w": 978,
        "h": 77
      },
      "type": "text",
      "tag": "p",
      "level": null,
      "text": "There is a modified build of Bugs N' Guns that loads the minigame directly from the itch.io link provided above, though there are also hidden ways to access it within the game.",
      "links": [],
      "style": {
